import os
import time
import math

def main():
    A = 0
    B = 0
    
    # Czyszczenie ekranu na starcie
    os.system('cls' if os.name == 'nt' else 'clear')
    
    while True:
        z = [0] * 1760
        b = [' '] * 1760
        
        j = 0
        while j < 6.28:
            j += 0.07
            i = 0
            while i < 6.28:
                i += 0.02
                
                sinA = math.sin(A)
                cosA = math.cos(A)
                sinB = math.sin(B)
                cosB = math.cos(B)
                
                sini = math.sin(i)
                cosi = math.cos(i)
                sinj = math.sin(j)
                cosj = math.cos(j)
                
                cosj2 = cosj + 2
                mess = 1 / (sini * cosj2 * sinA + sinj * cosA + 5)
                t = sini * cosj2 * cosA - sinj * sinA
                
                # Obliczanie współrzędnych ekranu (x, y)
                x = int(40 + 30 * mess * (cosi * cosj2 * cosB - t * sinB))
                y = int(12 + 15 * mess * (cosi * cosj2 * sinB + t * cosB))
                o = int(x + 80 * y)
                
                # Obliczanie natężenia światła (indeks znaku ASCII)
                N = int(8 * ((sinj * sinA - sini * cosj * cosA) * cosB - sini * cosj * sinA - sinj * cosA - cosi * cosj * sinB))
                
                if 0 <= y < 22 and 0 <= x < 80 and mess > z[o]:
                    z[o] = mess
                    b[o] = ".,-~:;=!*#$@"[N if N > 0 else 0]
        
        # Powrót kursora na górę ekranu (zamiast czyszczenia, zapobiega migotaniu)
        print("\x1b[H", end="")
        
        for k in range(1760):
            print(b[k], end="" if (k + 1) % 80 != 0 else "\n")
            
        A += 0.04
        B += 0.02
        time.sleep(0.01)

if __name__ == "__main__":
    main()
